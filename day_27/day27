def student_grades():
    grades = {}

    while True:
        print("\n1. Add Student")
        print("2. View Students")
        print("3. Exit")

        choice = input("Choose an option: ")

        if choice == "1":
            name = input("Enter student name: ")
            score = float(input("Enter score: "))
            grades[name] = score

        elif choice == "2":
            for name, score in grades.items():
                print(f"{name}: {score}")

        elif choice == "3":
            break

student_grades()
